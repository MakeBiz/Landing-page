{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/company", "destination": "/", "permanent": true },
    { "source": "/openclaw", "destination": "/ai-agents", "permanent": true },
    { "source": "/servers", "destination": "/vps", "permanent": true },
    { "source": "/en/openclaw", "destination": "/en/ai-agents", "permanent": true },
    { "source": "/en/company", "destination": "/en", "permanent": true },
    { "source": "/en/servers", "destination": "/en/vps", "permanent": true },
    { "source": "/keysy/pink-rabbit-agent", "destination": "/keysy", "permanent": true },
    { "source": "/en/keysy/pink-rabbit-agent", "destination": "/en/keysy", "permanent": true },
    { "source": "/ru/keysy/pink-rabbit-agent", "destination": "/keysy", "permanent": true },
    { "source": "/keysy/case", "destination": "/keysy", "permanent": true },
    { "source": "/en/keysy/case", "destination": "/en/keysy", "permanent": true },
    { "source": "/ru/keysy/case", "destination": "/keysy", "permanent": true }
  ],
  "rewrites": [
    { "source": "/keysy/:slug", "destination": "/keysy/case" },
    { "source": "/ru/keysy/:slug", "destination": "/ru/keysy/case" },
    { "source": "/en/keysy/:slug", "destination": "/en/keysy/case" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()" }
      ]
    },
    {
      "source": "/(.*).(png|jpg|jpeg|gif|webp|avif|svg|ico|woff|woff2|ttf|otf)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/(.*).(css|js)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=600, stale-while-revalidate=3600" }
      ]
    }
  ]
}
